// Gera o Prisma Client, a biblioteca usada pela aplicação para consultar o banco.
generator client {
  provider = "prisma-client-js"
}

// Configura o PostgreSQL e lê a URL de conexão de uma variável de ambiente.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Aluno {
  id         Int         @id @default(autoincrement())
  nome       String      @db.VarChar(255)
  email      String      @unique @db.VarChar(255)
  telefone   String      @db.VarChar(20)
  nivel      String      @db.VarChar(20)
  inscricoes Inscricao[]

  @@map("aluno")
}

model Professor {
  id       Int    @id @default(autoincrement())
  nome     String @db.VarChar(255)
  email    String @unique @db.VarChar(255)
  telefone String @db.VarChar(20)
  aulas    Aula[]

  @@map("professor")
}

model Aula {
  id          Int         @id @default(autoincrement())
  dataHora    DateTime    @map("data_hora") @db.Timestamp
  localidade  String      @db.VarChar(255)
  nivel       String      @db.VarChar(20)
  vagas       Int
  professorId Int         @map("professor_id")
  professor   Professor   @relation(fields: [professorId], references: [id])
  inscricoes  Inscricao[]

  @@map("aula")
}

model Inscricao {
  alunoId       Int      @map("aluno_id")
  aulaId        Int      @map("aula_id")
  dataInscricao DateTime @default(now()) @map("data_inscricao") @db.Timestamp
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aula          Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@id([alunoId, aulaId])
  @@map("inscricao")
}